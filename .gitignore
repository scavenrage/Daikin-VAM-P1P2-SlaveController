# Generated local config (machine/session-specific, regenerated from sdkconfig.defaults)
ESP32-H2/sdkconfig
ESP32-H2/sdkconfig.old

# Editor/IDE
.vscode/
.idea/
.claude/

# OS junk
.DS_Store
Thumbs.db
